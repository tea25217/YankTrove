{
  "productName": "Yank Trove",
  "version": "0.11.0",
  "identifier": "com.yanktrove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yank Trove",
        "url": "index.html",
        "width": 960,
        "height": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../README.txt": "README.txt",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "licenses/THIRD_PARTY_LICENSES.md",
      "resources/bin/*": "bin/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  }
}
